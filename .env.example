# ---------------------------------------------------------------------------
# Connexion MongoDB (MongoDB Atlas ou MongoDB local)
# Exemple Atlas : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/atelier_ecriture?retryWrites=true&w=majority
# Exemple local  : mongodb://127.0.0.1:27017/atelier_ecriture
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secret de signature des sessions (JWT HMAC-SHA256).
# Generer avec : openssl rand -base64 48
# Ne JAMAIS modifier cette valeur en production sans invalider les sessions.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Identifiants de l'administrateur unique.
# Utilises uniquement par le script `npm run seed:admin`.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Fournisseur d'IA (architecture multi-fournisseurs).
# Valeurs supportees : gemini
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Cle API Gemini (cleve cote serveur uniquement, jamais exposee au navigateur).
# Obtenir une cle : https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Modele Gemini utilise par le fournisseur IA.
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Point d'entree de l'API Gemini (facultatif).
# Utile pour les tests d'integration ou un proxy : la valeur par defaut est
# l'API officielle Google.
# ---------------------------------------------------------------------------
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Duree de vie de la session (secondes). 43200 = 12 heures.
# ---------------------------------------------------------------------------
SESSION_MAX_AGE=43200

# ---------------------------------------------------------------------------
# URL publique du deploiement (facultatif, utilisee par les metadonnees).
# Exemple Render : https://atelier-ecriture.onrender.com
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000