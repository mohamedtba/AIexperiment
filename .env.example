# ---------------------------------------------------------------------------
# Connexion PostgreSQL (Neon, Supabase, Render, ou un serveur local)
# Exemple Neon : postgresql://utilisateur:motdepasse@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Exemple local : postgresql://postgres:postgres@127.0.0.1:5432/atelier
# Le TLS se regle dans l'URL : sslmode=verify-full (defaut recommande), require
# ou disable. Les identifiants doivent etre encodes en URL si ils contiennent
# des caracteres speciaux (@ : / ? # % &).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secret de signature des sessions (JWT HMAC-SHA256).
# Generer avec : openssl rand -base64 48
# Ne JAMAIS modifier cette valeur en production sans invalider les sessions.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Identifiants de l'administrateur unique.
# Utilises uniquement par le script `npm run seed:admin`.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Fournisseur d'IA (architecture multi-fournisseurs).
# Valeurs supportees : openai, gemini
# ---------------------------------------------------------------------------
AI_PROVIDER=openai

# ---------------------------------------------------------------------------
# Cle API OpenAI (cleve cote serveur uniquement, jamais exposee au navigateur).
# Obtenir une cle : https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

# Point d'entree de l'API OpenAI (facultatif).
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Fournisseur IA Gemini (conserve pour compatibilite si vous revenez a Gemini).
# Valeurs supportees : gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Duree de vie de la session (secondes). 43200 = 12 heures.
# ---------------------------------------------------------------------------
SESSION_MAX_AGE=43200

# ---------------------------------------------------------------------------
# Tentatives de connexion autorisees par minute et par adresse IP.
# 12 = valeur par defaut (frein contre le forcage brutal de mots de passe a
# 4 chiffres). A augmenter uniquement si toute une classe se connecte derriere
# la meme adresse IP publique : cela ne rend pas l'echantillonnage plus facile
# par compte, cela evite seulement de bloquer la salle entiere.
# ---------------------------------------------------------------------------
LOGIN_ATTEMPTS_PER_MINUTE=12

# ---------------------------------------------------------------------------
# URL publique du deploiement (facultatif, utilisee par les metadonnees).
# Exemple Render : https://atelier-ecriture.onrender.com
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000